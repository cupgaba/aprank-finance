# Bot settings
BOT_TOKEN=your_bot_token_here

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# Admin Telegram IDs (comma-separated)
# These users will have admin access automatically
ADMIN_IDS=123456789,987654321

# Channel ID for publications (optional)
# Get it by forwarding a message from the channel to @userinfobot
CHANNEL_ID=-1001234567890

# Log channel ID for logging changes (optional)
LOG_CHANNEL_ID=-1001234567891

# Reservation settings
RESERVATION_HOURS=24

# Scheduler settings
# Sales reminder time (24-hour format)
SALES_REMINDER_HOUR=23
SALES_REMINDER_MINUTE=0

# Daily pricelist publication time
PRICELIST_HOUR=10
PRICELIST_MINUTE=0

# Timezone
TIMEZONE=Europe/Moscow
